<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="8dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/unit_widget_feedback"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:text="세대현관" android:textColor="#F2F2F7" android:textSize="13sp"
        android:textStyle="bold" android:gravity="center" android:maxLines="2" />
    <TextView android:id="@+id/unit_widget_open"
        android:layout_width="76dp" android:layout_height="48dp" android:layout_marginStart="6dp"
        android:text="문 열기" android:textColor="#FFFFFF" android:textSize="14sp"
        android:textStyle="bold" android:gravity="center" android:maxLines="1"
        android:background="@drawable/widget_call_background"
        android:contentDescription="세대현관 문 열기" />
</LinearLayout>
