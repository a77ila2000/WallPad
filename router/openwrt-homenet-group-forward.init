#!/bin/sh /etc/rc.common

START=96
STOP=10

apply_group_forward_mask() {
	local mask_path="/sys/class/net/br-homenet/bridge/group_fwd_mask"
	local attempt=0

	while [ "$attempt" -lt 30 ]; do
		if [ -e "$mask_path" ]; then
			echo 8 > "$mask_path"
			logger -t homenet-group-forward "br-homenet group_fwd_mask=$(cat "$mask_path")"
			return 0
		fi
		attempt=$((attempt + 1))
		sleep 1
	done

	logger -t homenet-group-forward "br-homenet was not created"
	return 1
}

start() {
	apply_group_forward_mask
}
