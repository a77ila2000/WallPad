#!/bin/sh /etc/rc.common

# USB ADB server bound to router loopback; use authenticated SSH for access.
START=98
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/adb -P 5037 nodaemon server
    procd_set_param respawn 5 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
