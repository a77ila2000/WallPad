#!/bin/sh /etc/rc.common

START=97
STOP=9
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/libexec/elevator-status-poller
    procd_set_param respawn 5 5 0
    procd_set_param term_timeout 8
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger network
}
