#!/bin/sh /etc/rc.common

START=97
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/uhttpd -f -p 0.0.0.0:8088 -h /www/elevator -I index.html -x /cgi-bin -D -S
    procd_set_param respawn 5 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
